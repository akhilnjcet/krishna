{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|models|assets|icons|favicon.ico|manifest.json|sw.js|robots.txt|sitemap.xml|logo).*)",
      "destination": "/index.html"
    }
  ],
  "outputDirectory": "frontend/dist"
}
