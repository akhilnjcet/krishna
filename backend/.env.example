# ==============================================================================
# SECURE DEPLOYMENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# 1. NEVER commit production secrets, keys, or passwords into source control.
# 2. In production, provide these environment variables via your cloud host's
#    encrypted secret manager (e.g., Vercel Project Settings, AWS Secrets Manager,
#    or Docker Swarm / Kubernetes Secrets).
# 3. In production (NODE_ENV=production), weak default secrets will trigger an
#    immediate startup failure in backend/config/validateEnv.js.
# ==============================================================================

# Application Environment ('development' or 'production')
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# Database Configuration (Restricted Network Access)
# ------------------------------------------------------------------------------
# Best Practice: Restrict MongoDB Atlas IP Access List to your specific server
# or NAT Gateway IPs only. NEVER use 0.0.0.0/0 in production.
# Ensure TLS/SSL is enforced (mongodb+srv:// handles TLS automatically).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-domain>/<dbname>?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Authentication & Cryptographic Keys
# ------------------------------------------------------------------------------
# Must be a high-entropy string (at least 32 random characters).
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret

# ------------------------------------------------------------------------------
# CORS & Web Origins (Enforce HTTPS)
# ------------------------------------------------------------------------------
# Whitelist only your production HTTPS domains (comma-separated if multiple).
CLIENT_URL=https://your-domain.com

# ------------------------------------------------------------------------------
# Cashfree Payment Gateway Credentials
# ------------------------------------------------------------------------------
# CASHFREE_ENVIRONMENT: 'SANDBOX' for testing, 'PRODUCTION' for live payments
CASHFREE_ENVIRONMENT=PRODUCTION
CASHFREE_APP_ID=your_cashfree_production_app_id
CASHFREE_SECRET_KEY=your_cashfree_production_secret_key

# ------------------------------------------------------------------------------
# SMTP Email Notification Credentials
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-service-account@gmail.com
EMAIL_PASS=your-generated-app-password

# ------------------------------------------------------------------------------
# Server-Side AI Generation & External API Keys (NEVER expose to frontend)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_gsk
OPENAI_API_KEY=your_openai_api_key_sk
GEMINI_API_KEY=your_google_gemini_api_key
DRIVE_API_KEY=your_google_drive_api_key

